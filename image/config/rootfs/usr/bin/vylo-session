#!/bin/sh
# The VYLO session: the labwc compositor with vylo-shell. The labwc settings
# live in /usr/share/vylo so they do not affect any other labwc setup.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=VYLO
# Lets the compositor start in virtual machines without 3D acceleration.
export WLR_RENDERER_ALLOW_SOFTWARE=1

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/vylo"
mkdir -p "$log_dir"

exec labwc -C /usr/share/vylo/labwc >"$log_dir/session.log" 2>&1
