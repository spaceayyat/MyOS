#!/bin/sh
# Optional MyOS session: the labwc compositor with myos-shell. Selected on the
# login screen; KDE Plasma stays the default. The labwc configuration lives in
# /usr/share/myos so it does not affect any other labwc setup.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=MyOS

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/myos"
mkdir -p "$log_dir"

exec labwc -C /usr/share/myos/labwc >"$log_dir/session.log" 2>&1
