#!/usr/bin/env python3
"""Give the web installer the VYLO look. Run once while the image is built.

The installer draws itself dark only when the browser asks for it, so this
copies the installer's own dark colour set into its branding style sheet and
adds the VYLO colours on top. The result goes in /etc/cockpit/branding, which
the installer's web server reads before any packaged branding. Stops with an
error if the installer no longer looks the way this expects.
"""
import argparse
import gzip
import pathlib
import re
import shutil
import sys

DARK = ":root:where(.pf-v6-theme-dark){"


def build(styles: str, theme: str) -> str:
    start = styles.find(DARK)
    if start < 0:
        sys.exit("installer-theme: the installer has no dark colour set")
    start += len(DARK)
    dark = styles[start:styles.index("}", start)]
    if dark.count("--pf-t--") < 100:
        sys.exit("installer-theme: the dark colour set looks incomplete")
    # Every colour the theme changes must still exist in the installer.
    for name in re.findall(r"^\s*(--pf-t--[\w-]+):", theme, re.MULTILINE):
        if name + ":" not in styles:
            sys.exit(f"installer-theme: the installer no longer uses {name}")
    return f"/* installer dark colours */\n:root:root{{{dark}}}\n\n{theme}"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--installer", default="/usr/share/cockpit/anaconda-webui")
    parser.add_argument("--source", default="/usr/share/vylo/installer")
    parser.add_argument("--background", default="/usr/share/wallpapers/vylo/cosmos-indigo.jpg")
    parser.add_argument("--out", default="/etc/cockpit/branding")
    args = parser.parse_args()
    installer, source, out = map(pathlib.Path, (args.installer, args.source, args.out))

    packed = installer / "index.css.gz"
    styles = (gzip.decompress(packed.read_bytes()).decode() if packed.exists()
              else (installer / "index.css").read_text())
    css = build(styles, (source / "theme.css").read_text())

    out.mkdir(parents=True, exist_ok=True)
    files = {"logo.png": source / "mark.png", "background.jpg": pathlib.Path(args.background)}
    (out / "branding.css").write_text(css)
    for name, origin in files.items():
        shutil.copyfile(origin, out / name)
    print(f"installer-theme: wrote {out}")


if __name__ == "__main__":
    main()
