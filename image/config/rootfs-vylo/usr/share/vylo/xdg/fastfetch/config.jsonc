// VYLO's system summary, shown by `fastfetch` in the VYLO desktop and by
// `vylo info`. Copy to ~/.config/fastfetch/config.jsonc to change it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/vylo/fastfetch/logo.txt",
    "color": { "1": "38;2;74;71;255", "2": "38;2;194;120;255" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;194;120;255", "title": "38;2;74;71;255" }
  },
  "modules": [
    "break",
    "title",
    "separator",
    { "type": "os", "key": "System  " },
    { "type": "host", "key": "Machine " },
    { "type": "kernel", "key": "Kernel  " },
    { "type": "uptime", "key": "Uptime  " },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell   " },
    { "type": "wm", "key": "Windows " },
    { "type": "terminal", "key": "Terminal" },
    "break",
    { "type": "cpu", "key": "CPU     " },
    { "type": "gpu", "key": "Graphics" },
    { "type": "memory", "key": "Memory  " },
    { "type": "disk", "key": "Disk    ", "folders": "/" },
    "break",
    "colors"
  ]
}
