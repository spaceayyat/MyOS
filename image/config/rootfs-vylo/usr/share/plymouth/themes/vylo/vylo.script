# VYLO boot splash: the logo, three slow dots, and the disk passphrase prompt.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + screen.w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + screen.h * 0.42 - logo.image.GetHeight() / 2);

dot.image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot.image);
    dots[i].SetX(Window.GetX() + screen.w / 2 - dot.image.GetWidth() / 2 + (i - 1) * 24);
    dots[i].SetY(Window.GetY() + screen.h * 0.72);
}
tick = 0;
fun refresh() {
    tick++;
    for (i = 0; i < 3; i++)
        dots[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin(tick / 18 - i * 0.7)));
}
Plymouth.SetRefreshFunction(refresh);

fun text_line(text, y) {
    image = Image.Text(text, 0.96, 0.95, 1);
    sprite = Sprite(image);
    sprite.SetX(Window.GetX() + screen.w / 2 - image.GetWidth() / 2);
    sprite.SetY(Window.GetY() + y);
    return sprite;
}

fun ask_password(prompt, bullets) {
    stars = "";
    for (i = 0; i < bullets; i++)
        stars += "*";
    global.question = text_line(prompt, screen.h * 0.80);
    global.answer = text_line(stars, screen.h * 0.84);
}
fun show_prompt_done() {
    global.question = null;
    global.answer = null;
}
fun show_message(text) {
    global.message = text_line(text, screen.h * 0.90);
}
fun hide_message(text) {
    global.message = null;
}
Plymouth.SetDisplayPasswordFunction(ask_password);
Plymouth.SetDisplayNormalFunction(show_prompt_done);
Plymouth.SetDisplayMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);
