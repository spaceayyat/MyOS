<?xml version="1.0" encoding="utf-8"?>
<!--
  MyOS live ISO: Fedora 44, built with KIWI. Two editions (profiles):
    GNOME   the main edition; Helium is its only browser
    Plasma  the KDE Plasma edition; Helium by default, plus Firefox

  Build it with scripts/build-iso.sh inside Fedora 44 (CI does this in a
  container). Ubuntu's KIWI package is too old to read this file.

  Security:
    * No user accounts are defined here. The live user is created at boot by
      livesys-scripts, only when booted as live media. An installed system has
      only the users created in the installer.
    * root is locked.
    * Every RPM is signature checked against the Fedora 44 key.
    * SELinux is enforcing.
-->
<image schemaversion="8.4" name="MyOS-Live">
  <description type="system">
    <author>MyOS contributors</author>
    <contact>noreply@example.invalid</contact>
    <specification>MyOS: Fedora-based workstation (live and installable)</specification>
  </description>

  <profiles>
    <profile name="GNOME" description="GNOME edition" import="true"/>
    <profile name="Plasma" description="KDE Plasma edition"/>
  </profiles>

  <preferences>
    <version>0.3.0</version>
    <packagemanager>dnf5</packagemanager>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <rpm-check-signatures>true</rpm-check-signatures>
    <!-- firmware="uefi" on an ISO also produces a legacy BIOS boot record
         when the grub2 i386-pc modules are installed. -->
    <type image="iso"
          flags="dmsquash"
          firmware="uefi"
          volid="MYOS_LIVE"
          application_id="MyOS-Live"
          publisher="MyOS contributors"
          kernelcmdline="rd.live.image quiet rhgb">
      <bootloader name="grub2" timeout="5"/>
    </type>
  </preferences>

  <users>
    <user name="root" password="*" pwdformat="encrypted" home="/root"/>
  </users>

  <repository type="rpm-md" alias="fedora"
              repository_gpgcheck="false" package_gpgcheck="true">
    <source path="https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/">
      <signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-44-primary"/>
    </source>
  </repository>
  <repository type="rpm-md" alias="fedora-updates"
              repository_gpgcheck="false" package_gpgcheck="true">
    <source path="https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/x86_64/">
      <signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-44-primary"/>
    </source>
  </repository>

  <!-- Helium Browser: the project's own COPR repository (third party). The
       key is kept in this repository; scripts/build-iso.sh fills in @ROOT@.
       Fingerprint 07BC FCA3 0AC7 E51B CFED FFF7 4A31 86EA 4791 2C39 -->
  <repository type="rpm-md" alias="helium"
              repository_gpgcheck="false" package_gpgcheck="true">
    <source path="https://download.copr.fedorainfracloud.org/results/imput/helium/fedora-44-x86_64/">
      <signing key="file://@ROOT@/image/config/rootfs/etc/pki/rpm-gpg/RPM-GPG-KEY-imput-helium"/>
    </source>
  </repository>

  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc-langpack-en"/>
  </packages>
  <!-- Not fedora-release-workstation: with it, anaconda-webui requires Firefox. -->
  <packages type="bootstrap" profiles="GNOME">
    <package name="fedora-release"/>
    <package name="fedora-release-identity-basic"/>
  </packages>
  <packages type="bootstrap" profiles="Plasma">
    <package name="fedora-release-kde-desktop"/>
    <package name="fedora-release-identity-kde-desktop"/>
  </packages>

  <packages type="image">
    <!-- Boot: UEFI (including Secure Boot), legacy BIOS, live media -->
    <package name="kernel"/>
    <package name="kernel-modules"/>
    <package name="kernel-modules-extra"/>
    <package name="dracut"/>
    <package name="dracut-live"/>
    <package name="dracut-config-generic"/>
    <package name="grub2-common"/>
    <package name="grub2-efi-x64"/>
    <package name="grub2-efi-x64-cdboot"/>
    <package name="grub2-efi-x64-modules"/>
    <package name="grub2-pc"/>
    <package name="grub2-pc-modules"/>
    <package name="grub2-tools"/>
    <package name="grub2-tools-extra"/>
    <package name="grubby"/>
    <package name="shim-x64"/>
    <package name="efibootmgr"/>
    <package name="mokutil"/>
    <package name="plymouth"/>
    <package name="plymouth-system-theme"/>

    <!-- Base system -->
    <package name="systemd"/>
    <package name="systemd-udev"/>
    <package name="systemd-pam"/>
    <package name="systemd-resolved"/>
    <package name="dbus-broker"/>
    <package name="bash"/>
    <package name="coreutils"/>
    <package name="util-linux"/>
    <package name="shadow-utils"/>
    <package name="pam"/>
    <package name="authselect"/>
    <package name="sudo"/>
    <package name="less"/>
    <package name="nano"/>
    <package name="rootfiles"/>
    <package name="zram-generator-defaults"/>
    <package name="glibc-all-langpacks"/>
    <package name="dnf5"/>
    <package name="curl"/>

    <!-- Storage -->
    <package name="btrfs-progs"/>
    <package name="e2fsprogs"/>
    <package name="xfsprogs"/>
    <package name="dosfstools"/>
    <package name="cryptsetup"/>
    <package name="lvm2"/>
    <package name="udisks2"/>
    <package name="snapper"/>

    <!-- Security and maintenance -->
    <package name="selinux-policy-targeted"/>
    <package name="policycoreutils"/>
    <package name="firewalld"/>
    <package name="dnf5-plugin-automatic"/>

    <!-- Hardware support -->
    <package name="linux-firmware"/>
    <package name="amd-gpu-firmware"/>
    <package name="amd-ucode-firmware"/>
    <package name="intel-gpu-firmware"/>
    <package name="nvidia-gpu-firmware"/>
    <package name="iwlwifi-dvm-firmware"/>
    <package name="iwlwifi-mvm-firmware"/>
    <package name="iwlwifi-mld-firmware"/>
    <package name="realtek-firmware"/>
    <package name="atheros-firmware"/>
    <package name="brcmfmac-firmware"/>
    <package name="mt7xxx-firmware"/>
    <package name="alsa-sof-firmware"/>
    <package name="microcode_ctl"/>
    <package name="mesa-dri-drivers"/>
    <package name="mesa-vulkan-drivers"/>
    <package name="mesa-libEGL"/>
    <package name="xkeyboard-config"/>
    <package name="fwupd"/>
    <package name="tuned-ppd"/>

    <!-- Network, sound, Bluetooth, printing -->
    <package name="NetworkManager"/>
    <package name="NetworkManager-wifi"/>
    <package name="wpa_supplicant"/>
    <package name="pipewire"/>
    <package name="pipewire-alsa"/>
    <package name="pipewire-pulseaudio"/>
    <package name="wireplumber"/>
    <package name="pipewire-utils"/>
    <package name="bluez"/>
    <package name="cups"/>
    <package name="cups-filters"/>

    <!-- Fonts and user directories -->
    <package name="google-noto-sans-fonts"/>
    <package name="google-noto-sans-mono-fonts"/>
    <package name="google-noto-color-emoji-fonts"/>
    <package name="xdg-user-dirs"/>
    <package name="flatpak"/>

    <!-- Default browser (third-party repository, see above) -->
    <package name="helium-bin"/>
    <!-- xdg-open and xdg-mime; GNOME does not pull them in by itself -->
    <package name="xdg-utils"/>

    <!-- Live session and installer -->
    <package name="livesys-scripts"/>
    <package name="anaconda-live"/>
    <!-- Storage plugins and filesystem tools the installer needs to partition
         disks; without them every installation fails -->
    <package name="anaconda-install-env-deps"/>

    <!-- Optional MyOS session (myos-shell on labwc); never the default -->
    <package name="labwc"/>
    <package name="foot"/>
    <package name="qt6-qtbase"/>
    <package name="qt6-qtbase-gui"/>
    <package name="qt6-qtdeclarative"/>
    <package name="qt6-qtwayland"/>
    <package name="layer-shell-qt"/>
  </packages>

  <packages type="image" profiles="GNOME">
    <package name="gnome-shell"/>
    <package name="gdm"/>
    <package name="gnome-session-wayland-session"/>
    <package name="mutter"/>
    <package name="gnome-control-center"/>
    <package name="gnome-settings-daemon"/>
    <package name="nautilus"/>
    <package name="ptyxis"/>
    <package name="gnome-text-editor"/>
    <package name="gnome-software"/>
    <package name="gnome-tweaks"/>
    <package name="gnome-extensions-app"/>
    <package name="gnome-initial-setup"/>
    <package name="gnome-tour"/>
    <package name="loupe"/>
    <package name="papers"/>
    <package name="gnome-system-monitor"/>
    <package name="gnome-disk-utility"/>
    <package name="file-roller"/>
    <package name="gnome-calculator"/>
    <package name="gnome-bluetooth"/>
    <package name="xdg-desktop-portal-gnome"/>
    <package name="adwaita-icon-theme"/>
  </packages>

  <packages type="image" profiles="Plasma">
    <package name="plasma-desktop"/>
    <package name="plasma-workspace"/>
    <package name="plasma-login-manager"/>
    <package name="kwin"/>
    <package name="plasma-systemsettings"/>
    <package name="kscreen"/>
    <package name="kinfocenter"/>
    <package name="powerdevil"/>
    <package name="plasma-nm"/>
    <package name="plasma-pa"/>
    <package name="bluedevil"/>
    <package name="plasma-print-manager"/>
    <package name="plasma-firewall"/>
    <package name="plasma-disks"/>
    <package name="plasma-systemmonitor"/>
    <package name="plasma-discover"/>
    <package name="plasma-discover-flatpak"/>
    <package name="plasma-welcome"/>
    <package name="plasma-breeze"/>
    <package name="kde-gtk-config"/>
    <package name="breeze-gtk"/>
    <package name="breeze-icon-theme"/>
    <package name="xdg-desktop-portal-kde"/>
    <package name="polkit-kde"/>
    <package name="konsole"/>
    <package name="dolphin"/>
    <package name="kate"/>
    <package name="ark"/>
    <package name="spectacle"/>
    <package name="gwenview"/>
    <package name="okular"/>
    <package name="firefox"/>
  </packages>
</image>
